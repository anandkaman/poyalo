# Copy to apps/api/.env for local development. Never commit real secrets.

NODE_ENV=development
# api | realtime | worker   (docs/D1: one codebase, three run modes)
MODE=api
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://poyalo:poyalo@localhost:5432/poyalo?schema=public
REDIS_URL=redis://localhost:6379

OSRM_CAR_URL=http://localhost:5000
OSRM_BIKE_URL=http://localhost:5000

# Comma-separated origins allowed by CORS (web + admin)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Idempotency keys are kept this long (seconds)
IDEMPOTENCY_TTL_S=86400
